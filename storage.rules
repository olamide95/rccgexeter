rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Photos and video: the public site reads them, only signed-in parish
    // admins may upload. Add the same emails you put in ADMIN_EMAILS.
    match /media/{folder}/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email in [
                        'pastor@rccgexeter.org',
                        'media@rccgexeter.org'
                      ]
                   && request.resource.size < 200 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*'));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
