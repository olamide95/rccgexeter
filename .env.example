# ─────────────────────────────────────────────────────────────
#  FIREBASE — server (Admin SDK)
#  Project settings → Service accounts → Generate new private key
# ─────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=rccg-exeter
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@rccg-exeter.iam.gserviceaccount.com
# Keep the \n escapes and the surrounding quotes exactly as the JSON gives them
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=rccg-exeter.firebasestorage.app

# Open /admin without Firebase while developing locally (never set true in production)
ALLOW_LOCAL_ADMIN=false

# Who may sign in to /admin — comma separated, must match Firebase Auth users
ADMIN_EMAILS=pastor@rccgexeter.org,media@rccgexeter.org

# ─────────────────────────────────────────────────────────────
#  FIREBASE — browser (client SDK). These are safe to expose.
#  Project settings → General → Your apps → Web app → Config
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=rccg-exeter.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rccg-exeter
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=rccg-exeter.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef

# ─────────────────────────────────────────────────────────────
#  OPTIONAL — email prayer requests as they arrive (resend.com)
#  Leave blank and requests are still saved to Firestore
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
PRAYER_TO_EMAIL=prayer@rccgexeter.org
PRAYER_FROM_EMAIL=website@rccgexeter.org
